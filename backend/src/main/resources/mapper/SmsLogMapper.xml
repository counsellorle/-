<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.order.repository.SmsLogMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.order.entity.SmsLog">
        <id column="id" property="id"/>
        <result column="phone" property="phone"/>
        <result column="template_code" property="templateCode"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="sent_at" property="sentAt"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, phone, template_code, content, status, sent_at, created_at
    </sql>

</mapper>
